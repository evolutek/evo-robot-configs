# Stable symlinks for the 3 USB cameras of Hololutek 2026.
#
# The Innomaker U20CAM-1080p modules all expose the same USB serial
# (SN0001) so we cannot disambiguate by ID. We bind to the physical
# port on the USB hub instead (KERNELS=). Plugging a camera into a
# different port = the symlink follows the port, not the camera.
#
# Mapping (look at the side panel of the hub):
#   port 1.3.1 -> /dev/CAM_FACE1
#   port 1.3.2 -> /dev/CAM_FACE2
#   port 1.3.3 -> /dev/CAM_FACE3
#
# index==0 selects the first /dev/videoN exposed by each camera (the
# image stream). UVC also exposes index==1 as a metadata stream we
# do not use.
#
# Append these lines to /etc/udev/rules.d/evolutek.rules on the robot,
# then run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger

KERNEL=="video[0-9]*", KERNELS=="1-1.3.1", ATTR{index}=="00", ATTR{name}=="Innomaker-U20CAM-1080p-S1: Inno", SYMLINK+="CAM_FACE1"
KERNEL=="video[0-9]*", KERNELS=="1-1.3.2", ATTR{index}=="00", ATTR{name}=="Innomaker-U20CAM-1080p-S1: Inno", SYMLINK+="CAM_FACE2"
KERNEL=="video[0-9]*", KERNELS=="1-1.3.3", ATTR{index}=="00", ATTR{name}=="Innomaker-U20CAM-1080p-S1: Inno", SYMLINK+="CAM_FACE3"
