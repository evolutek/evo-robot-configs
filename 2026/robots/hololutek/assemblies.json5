  // -- Proto: 2 fingers on left side of 1 face --
  carte_actionneurs: {
    face_0: {
      type: "gripper",
      fingers: [
        {
          // Doigt 1 (far left)
          ax12:  { type: "ax12", id: 3 },              // J14
          grip:  { type: "servo", bus: "carte_actionneurs.pca", channel: 2 },
          wrist: { type: "servo", bus: "carte_actionneurs.pca", channel: 3 },
          // color: { type: "color_sensor", bus: "carte_actionneurs.tca", channel: TODO },
        },
        {
          // Doigt 2 (center-left)
          ax12:  { type: "ax12", id: 2 },              // J12
          grip:  { type: "servo", bus: "carte_actionneurs.pca", channel: 0 },
          wrist: { type: "servo", bus: "carte_actionneurs.pca", channel: 1 },
          // color: { type: "color_sensor", bus: "carte_actionneurs.tca", channel: TODO },
        },
      ],
    },
  },

  // Recal sensor channel assignments for this year
  recal: {
    channels: [0, 1, 2, 3], // ADS1115 channels
  },
}
