{
  // Hololutek 2026 — Actuator & sensor assemblies
  //
  // Assemblies are grouped by the board they are connected to.
  // Each component has a "type" field for driver dispatch
  // and a "bus" ref to a chip defined in platforms/hololutek.json5.
  //
  // Per finger: 1 AX12 + 2 servos (PCA) + 1 color sensor (TCA)

  // -- Final design (3 faces x 4 fingers) --
  // carte_actionneurs: {
  //   face_0: {
  //     type: "gripper",
  //     fingers: {
  //       count: 4,
  //       each: {
  //         ax12:  { type: "ax12" },
  //         grip:  { type: "servo", bus: "carte_actionneurs.pca" },
  //         wrist: { type: "servo", bus: "carte_actionneurs.pca" },
  //         color: { type: "color_sensor", bus: "carte_actionneurs.tca" },
  //       },
  //       offsets: { ax12: 0, pca: 0, tca: 0 },
  //     },
  //   },
  //   face_1: {
  //     type: "gripper",
  //     fingers: {
  //       count: 4,
  //       each: {
  //         ax12:  { type: "ax12" },
  //         grip:  { type: "servo", bus: "carte_actionneurs.pca" },
  //         wrist: { type: "servo", bus: "carte_actionneurs.pca" },
  //         color: { type: "color_sensor", bus: "carte_actionneurs.tca" },
