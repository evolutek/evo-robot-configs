{
  // Hololutek 2026 — Actions v2: positions + parameterized sequences
  //
  // Format: shared positions + actions with inputs and target groups.
  // The IA graph can call actions with parameters (e.g. grab(face=0, finger=1)).
  // Simple {name} substitution resolves inputs in target paths and position refs.
  // Complex logic (sensor reads, conditionals) stays in Python code.
  //
  // Component names (ax12, grip, wrist) match keys in assemblies.json5 fingers.
  // Values from proto testing (doigt 2 only). All positions need calibration.
  // AX12 range: 0-1023 (native Dynamixel units, ~300 deg)
  // Servo range: 0-180 (degrees, DS041MG)

  // Shared positions, referenced by actions below
  positions: {
    finger: {
      folded:  { ax12: 0,   grip: 0,   wrist: 0   },
      open:    { ax12: 0,   grip: 0,   wrist: 180 },
      lowered: { ax12: 200, grip: 0,   wrist: 180 },
      gripped: { ax12: 200, grip: 180, wrist: 180 },
      loaded:  { ax12: 0,   grip: 180, wrist: 180 },
    },
  },

  actions: {
    // Grab an object with one finger
    // Usage from IA: actions.run("grab", face="face_0", finger=0)
    grab: {
      inputs: {
        face:   { type: "string" },  // e.g. "face_0"
        finger: { type: "int" },     // finger index in the face
      },
      // Target resolves to a finger group in assemblies.json5:
      // carte_actionneurs.{face}.fingers[{finger}]
      target: "carte_actionneurs.{face}.fingers.{finger}",
      positions: "positions.finger",
      ax12_speed: 200,
      sequence: [
        { position: "folded",  wait: 3000 },
        { position: "open",    wait: 1000 },
        { position: "lowered", wait: 1000 },
        { position: "gripped", wait: 2000 },
        { position: "loaded" },
      ],
    },

    // Release a held object
    release: {
      inputs: {
        face:   { type: "string" },
        finger: { type: "int" },
      },
      target: "carte_actionneurs.{face}.fingers.{finger}",
      positions: "positions.finger",
      ax12_speed: 200,
      sequence: [
        { position: "open",    wait: 1000 },
        { position: "lowered", wait: 500  },
        { position: "open",    wait: 500  },
        { position: "folded" },
      ],
    },

    // Quick fold from any state (e.g. emergency or match end)
    stow: {
      inputs: {
        face:   { type: "string" },
        finger: { type: "int" },
      },
      target: "carte_actionneurs.{face}.fingers.{finger}",
      positions: "positions.finger",
      ax12_speed: 200,
      sequence: [
        { position: "folded" },
      ],
    },

    // Stow all fingers on all faces (match end safety)
    stow_all: {
      inputs: {},
      // Special target: applies to every finger across all faces
      target: "carte_actionneurs.*.fingers.*",
      positions: "positions.finger",
      ax12_speed: 200,
      sequence: [
        { position: "folded" },
      ],
    },
  },

  // Per-finger position overrides (only specify what differs)
  // Merged on top of positions at load time.
  //
  // overrides: {
  //   face_0: {
  //     0: { gripped: { ax12: 210 } },
  //   },
  // },
}
