{
  // Hololutek 2026 — Actions v1: positions & sequences
  //
  // Format: named positions (full actuator state snapshots) + ordered sequences.
  // The sequencer applies each position to all actuators in the target group,
  // then waits before the next step. No parameterization from the IA graph.
  //
  // Component names (ax12, grip, wrist) match keys in assemblies.json5 fingers.
  // Values from proto testing (doigt 2 only). All positions need calibration.
  // AX12 range: 0-1023 (native Dynamixel units, ~300 deg)
  // Servo range: 0-180 (degrees, DS041MG)

  finger: {
    // Named positions: full state snapshot of one finger
    // All fingers share these defaults; per-finger overrides below
    positions: {

      // Everything retracted, safe for robot movement
      folded: { ax12: 0, grip: 0, wrist: 0 },

      // Finger deployed, ready to approach object
      open: { ax12: 0, grip: 0, wrist: 180 },

      // Finger lowered onto object
      lowered: { ax12: 200, grip: 0, wrist: 180 },

      // Object gripped
      gripped: { ax12: 200, grip: 180, wrist: 180 },

      // Retracted with object held
      loaded: { ax12: 0, grip: 180, wrist: 180 },
    },

    // AX12 speed for finger movements (Dynamixel units, 0-1023)
    ax12_speed: 200, // TODO: calibrate

    // Action sequences: ordered list of { position, wait (ms) }
    // The sequencer moves all actuators to the target position,
    // then waits before proceeding to the next step.
    sequences: {
      grab: [
        { position: "folded",  wait: 3000 }, // deploy from safe state
        { position: "open",    wait: 1000 }, // wrist opens
        { position: "lowered", wait: 1000 }, // AX12 lowers onto object
        { position: "gripped", wait: 2000 }, // grip closes
        { position: "loaded"               }, // AX12 retracts with object
      ],

      release: [
        { position: "open",    wait: 1000 }, // deploy and open
        { position: "lowered", wait: 500  }, // lower to drop height
        { position: "open",    wait: 500  }, // release grip
        { position: "folded"               }, // retract
      ],

      // Quick fold from any state (e.g. emergency or match end)
      stow: [
        { position: "folded" },
      ],
    },

    // Per-finger position overrides (only specify what differs)
    // Merged on top of default positions at load time.
    //
    // overrides: {
    //   face_0: {
    //     0: {  // finger index
    //       gripped: { ax12: 210 },  // slightly different mechanical stop
    //     },
    //   },
    // },
  },
}
