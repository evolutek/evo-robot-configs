{
  // Hololutek 2026 — Actions v3: full declarative DSL (Kolte proposal)
  //
  // Format: each action is a mini-program with typed inputs, explicit peripheral
  // commands, and config path references. Any command can be called on any
  // peripheral type (not limited to set_angle).
  //
  // {value: "path"} resolves a value from this config file.
  // {input: "name"} uses a runtime parameter passed by the IA graph.
  // Peripheral names match keys in assemblies.json5 finger entries.
  //
  // Values from proto testing (doigt 2 only). All positions need calibration.
  // AX12 range: 0-1023 (native Dynamixel units, ~300 deg)
  // Servo range: 0-180 (degrees, DS041MG)

  version: 1,

  config: {
    positions: {
      finger: {
        folded:  { ax12: 0,   grip: 0,   wrist: 0   },
        open:    { ax12: 0,   grip: 0,   wrist: 180 },
        lowered: { ax12: 200, grip: 0,   wrist: 180 },
        gripped: { ax12: 200, grip: 180, wrist: 180 },
        loaded:  { ax12: 0,   grip: 180, wrist: 180 },
      },
    },
    speeds: {
      ax12_default: 200,
    },
  },

  actions: {
    // Grab an object with one finger
    // Usage from IA: actions.run("grab", face="face_0", finger=0)
    grab: {
      inputs: {
        face:     { type: "config_key", path: "carte_actionneurs" },
        finger:   { type: "int", min: 0, max: 3 },
        position: { type: "config_key", path: "config.positions.finger" },
      },
      commands: [
        // Set AX12 speed
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_speed",
          args: { speed: { value: "config.speeds.ax12_default" } } },

        // Move AX12 to target position
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.{position}.ax12" } } },

        // Move grip servo
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.{position}.grip" } } },

        // Move wrist servo
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.{position}.wrist" } } },
      ],
    },

    // Full grab sequence: folded -> open -> lowered -> gripped -> loaded
    grab_sequence: {
      inputs: {
        face:   { type: "config_key", path: "carte_actionneurs" },
        finger: { type: "int", min: 0, max: 3 },
      },
      commands: [
        // Speed setup
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_speed",
          args: { speed: { value: "config.speeds.ax12_default" } } },

        // Step 1: folded
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.folded.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.folded.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.folded.wrist" } } },
        { command: "wait", args: { duration: 3000 } },

        // Step 2: open
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.open.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.open.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.open.wrist" } } },
        { command: "wait", args: { duration: 1000 } },

        // Step 3: lowered
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.lowered.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.lowered.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.lowered.wrist" } } },
        { command: "wait", args: { duration: 1000 } },

        // Step 4: gripped
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.gripped.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.gripped.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.gripped.wrist" } } },
        { command: "wait", args: { duration: 2000 } },

        // Step 5: loaded
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.loaded.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.loaded.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.loaded.wrist" } } },
      ],
    },

    // Release sequence: open -> lowered -> open -> folded
    release_sequence: {
      inputs: {
        face:   { type: "config_key", path: "carte_actionneurs" },
        finger: { type: "int", min: 0, max: 3 },
      },
      commands: [
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_speed",
          args: { speed: { value: "config.speeds.ax12_default" } } },

        // Step 1: open
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.open.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.open.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.open.wrist" } } },
        { command: "wait", args: { duration: 1000 } },

        // Step 2: lowered
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.lowered.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.lowered.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.lowered.wrist" } } },
        { command: "wait", args: { duration: 500 } },

        // Step 3: open (release grip)
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.open.grip" } } },
        { command: "wait", args: { duration: 500 } },

        // Step 4: folded
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.folded.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.folded.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.folded.wrist" } } },
      ],
    },

    // Quick fold from any state
    stow: {
      inputs: {
        face:   { type: "config_key", path: "carte_actionneurs" },
        finger: { type: "int", min: 0, max: 3 },
      },
      commands: [
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_speed",
          args: { speed: { value: "config.speeds.ax12_default" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.ax12",
          command: "set_position",
          args: { position: { value: "config.positions.finger.folded.ax12" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.grip",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.folded.grip" } } },
        { peripheral: "carte_actionneurs.{face}.fingers.{finger}.wrist",
          command: "set_angle",
          args: { angle: { value: "config.positions.finger.folded.wrist" } } },
      ],
    },
  },
}
