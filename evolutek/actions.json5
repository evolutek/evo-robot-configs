{
    version: 1,

    // ========================================
    //                CONSTANTS
    // ========================================

    values: {
        positions: {
            // ========== Grab elevators position ==========
            grab_elevator: {
                front: {
                    lowest: -920,
                    middle: -700,
                    reverse_down: -340,
                    reverse_up: -150,
                    highest: -5,
                },
                /*back: {
                    lowest: -920,
                    middle: -700,
                    reverse_down: -340,
                    reverse_up: -150,
                    highest: -5,
                },*/
            }

            // ========== Lifting arms positions ==========
            lifting_arm: {
                front: {
                    opened: 820
                    pre_grab: 593
                    grab: 493
                    drop: 512
                    closed: 335
                },
                back: {
                    opened: 820
                    pre_grab: 593
                    grab: 493
                    drop: 512
                    closed: 335
                }
            }

            // ========== Compacting arms positions ==========
            compacting_arm: {
                front: {
                    right: {
                        opened: 155,
                        pre_tassed: 255,
                        tassed: 305,
                        closed: 600,
                    },
                    left: {
                        opened: 870,
                        pre_tassed: 770,
                        tassed: 720,
                        closed: 425,
                    },
                },
                /*back: {
                    right: {
                        opened: 155,
                        pre_tassed: 255,
                        tassed: 305,
                        closed: 600,
                    },
                    left: {
                        opened: 870,
                        pre_tassed: 770,
                        tassed: 720,
                        closed: 425,
                    },
                }*/
            },

            // ========== Reverser elevators positions ==========
            reverser_elevator: {
                front: {
                    top: 545,
                    closed: 840,
                    ground: 970,
                }
            },

            // ========== Reverser arms positions ==========
            reverser_arm: {
                front: {
                    right: {
                        crate1: 720,
                        crate2: 820,
                        crate3: 920,
                        crate4: null,
                        closed: 512,
                    },
                    left: {
                        crate1: null,
                        crate2: 104,
                        crate3: 204,
                        crate4: 304,
                        closed: 512,
                    }
                }
                //back: ...
            }

            // ========== Reverser heads positions ==========
            reverser_head: {
                front: {
                    right: {
                        normal: 0,
                        reversed: 180,
                    },
                    left: {
                        normal: 180,
                        reversed: 32,
                    },
                }
            },

            // ========== Cursor arms positions ==========
            cursor_arm: {
                right: {
                    deployed: 60,
                    closed: 4,
                },
                left: {
                    deployed: 120,
                    closed: 175,
                },
            }
        },

        speeds: {
            compacting_arm: {
                opened: 800,
                pre_tassed: 120,
                tassed: 800,
                closed: 800,
            }
        }
    },

    // ========================================
    //                 ACTIONS
    // ========================================

    actions: {
        move_grab_elevator: {
            inputs: {
                "id": {type: "str", path: "positions.grab_elevator"},
                "pos": {type: "str", path: "positions.grab_elevator.{id}"},
            },
            commands: [
                {peripheral: "grab_elevator.{id}", cmd: "go_to", args: {
                    position: {path: "positions.grab_elevator.{id}.{pos}"},
                }},
            ],
        },

        move_reverser_elevator: {
            inputs: {
                "side": {type: "str", path: "positions.reverser_elevator"},
                "pos": {type: "str", path: "positions.reverser_elevator.{side}"},
            },
            commands: [
                {peripheral: "reverser_elevator.{side}", cmd: "go_to", args: {
                    position: {path: "positions.reverser_elevator.{side}.{pos}"},
                }},
            ],
        },

        move_cursor_arm: {
            inputs: {
                "arm": {type: "str", path: "positions.cursor_arm"},
                "pos": {type: "str", path: "positions.cursor_arm.{arm}"},
            },
            commands: [
                {peripheral: "cursor_arm.{arm}", cmd: "go_to", args: {
                    position: {path: "positions.cursor_arm.{arm}.{pos}"},
                }},
            ],
        },

        move_reverser_head: {
            inputs: {
                "side": {type: "str", path: "positions.reverser_head"},
                "arm": {type: "str", path: "positions.reverser_head.{side}"},
                "pos": {type: "str", path: "positions.reverser_head.{side}.{arm}"},
            },
            commands: [
                {peripheral: "reverser_head.{side}.{arm}", cmd: "go_to", args: {
                    position: {path: "positions.reverser_head.{side}.{arm}.{pos}"},
                }},
            ],
        },

        move_reverser_arm: {
            inputs: {
                "side": {type: "str", path: "positions.reverser_arm"},
                "arm": {type: "str", path: "positions.reverser_arm.{side}"},
                "pos": {type: "str", path: "positions.reverser_arm.{side}.{arm}"},
            },
            commands: [
                {peripheral: "reverser_arm.{side}.{arm}", cmd: "go_to", args: {
                    position: {path: "positions.reverser_arm.{side}.{arm}.{pos}"},
                }},
            ],
        },

        move_compacting_arm: {
            inputs: {
                "side": {type: "str", path: "positions.compacting_arm"},
                "arm": {type: "str", path: "positions.compacting_arm.{side}"},
                "pos": {type: "str", path: "positions.compacting_arm.{side}.{arm}"},
            },
            commands: [
                {peripheral: "compacting_arm.{side}.{arm}", cmd: "go_to", args: {
                    position: {path: "positions.compacting_arm.{side}.{arm}.{pos}"},
                    speed: {path: "speeds.compacting_arm.{pos}"}
                }},
            ],
        },

        move_lifting_arm: {
            inputs: {
                "arm": {type: "int", min: 1, max: 4},
                "side": {type: "str", path: "positions.lifting_arm"},
                "pos": {type: "str", path: "positions.lifting_arm.{side}"},
            },
            commands: [
                {peripheral: "lifting_arm.{side}.{arm}", cmd: "go_to", args: {
                    position: {path: "positions.lifting_arm.{side}.{pos}"},
                }},
            ],
        },

        pump_grab: {
            inputs: {
                "arm": {type: "int", min: 1, max: 4},
                "side": {type: "str"},
            },
            commands: [
                {peripheral: "pump.{side}.{arm}", cmd: "grab", args: {}},
            ],
        },

        pump_drop: {
            inputs: {
                "arm": {type: "int", min: 1, max: 4},
                "side": {type: "str"},
            },
            commands: [
                {peripheral: "pump.{side}.{arm}", cmd: "drop", args: {}},
            ],
        },
    }
}
